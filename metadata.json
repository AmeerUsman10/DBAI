{
  "version": "1.0",
  "last_updated": "2026-01-04",
  "description": "Comprehensive metadata for Pakistani textile manufacturing database",
  
  "tables": {
    "YarnData": {
      "description": "Yarn inventory and supplier transactions",
      "columns": {
        "SUPPLIER": {
          "description": "Supplier/vendor name",
          "type": "text",
          "examples": ["ABC Traders", "XYZ Suppliers"]
        },
        "AMOUNT": {
          "description": "Total transaction amount",
          "type": "currency",
          "unit": "PKR",
          "unit_full": "Pakistani Rupees"
        },
        "LBS": {
          "description": "Weight of yarn",
          "type": "number",
          "unit": "LBS",
          "unit_full": "Pounds"
        },
        "BAGS": {
          "description": "Number of bags",
          "type": "integer",
          "unit": "bags"
        },
        "RATE": {
          "description": "Rate per unit",
          "type": "currency",
          "unit": "PKR per LBS"
        },
        "DATE": {
          "description": "Transaction date",
          "type": "date",
          "format": "YYYY-MM-DD"
        },
        "INVOICE": {
          "description": "Invoice number",
          "type": "text"
        },
        "TYPE": {
          "description": "Yarn type/category",
          "type": "text",
          "examples": ["Cotton", "Polyester", "Blended"]
        },
        "COUNT": {
          "description": "Yarn count specification",
          "type": "text",
          "examples": ["30s", "40s", "60s"]
        },
        "COLOR": {
          "description": "Yarn color",
          "type": "text"
        }
      },
      "business_terms": {
        "PKR": "Pakistani Rupee - local currency (₨)",
        "LBS": "Pounds - standard weight unit for yarn in textile industry",
        "count": "Yarn thickness measurement (higher number = finer yarn)",
        "supplier": "Vendor providing raw materials",
        "rate": "Price per unit weight"
      },
      "common_queries": [
        {
          "pattern": "supplier name",
          "intent": "List all unique supplier names",
          "sql_template": "SELECT DISTINCT SUPPLIER FROM YarnData ORDER BY SUPPLIER"
        },
        {
          "pattern": "total amount",
          "intent": "Sum of all purchase amounts in PKR",
          "sql_template": "SELECT SUM(AMOUNT) as TotalAmountPKR FROM YarnData"
        },
        {
          "pattern": "supplier wise",
          "intent": "Group data by supplier with totals",
          "sql_template": "SELECT SUPPLIER, SUM(AMOUNT) as Total, SUM(LBS) as TotalLBS FROM YarnData GROUP BY SUPPLIER ORDER BY Total DESC"
        },
        {
          "pattern": "monthly total",
          "intent": "Monthly aggregated data",
          "sql_template": "SELECT FORMAT(DATE, 'yyyy-MM') as Month, SUM(AMOUNT) as Total FROM YarnData GROUP BY FORMAT(DATE, 'yyyy-MM')"
        }
      ],
      "sample_questions": [
        "What are the top 5 suppliers by purchase amount?",
        "Show me yarn purchases in the last 30 days",
        "What is the average rate per LBS by yarn type?",
        "Which supplier has the most bags delivered?"
      ]
    },
    
    "GreigeData": {
      "description": "Greige (unfinished) fabric inventory and transactions",
      "columns": {
        "SUPPLIER": {
          "description": "Greige fabric supplier name",
          "type": "text"
        },
        "AMOUNT": {
          "description": "Total transaction amount",
          "type": "currency",
          "unit": "PKR",
          "unit_full": "Pakistani Rupees"
        },
        "METERS": {
          "description": "Fabric length",
          "type": "number",
          "unit": "meters"
        },
        "INCHES": {
          "description": "Fabric width",
          "type": "number",
          "unit": "inches"
        },
        "RATE": {
          "description": "Rate per meter",
          "type": "currency",
          "unit": "PKR per meter"
        },
        "DATE": {
          "description": "Transaction date",
          "type": "date",
          "format": "YYYY-MM-DD"
        },
        "INVOICE": {
          "description": "Invoice number",
          "type": "text"
        },
        "QUALITY": {
          "description": "Fabric quality grade",
          "type": "text",
          "examples": ["A Grade", "B Grade", "Premium"]
        },
        "CONSTRUCTION": {
          "description": "Fabric construction specification",
          "type": "text",
          "examples": ["40x40 133x72", "60x60 90x88"]
        },
        "DEPARTMENT": {
          "description": "Receiving department",
          "type": "text"
        }
      },
      "business_terms": {
        "greige": "Unfinished/raw fabric before dyeing and finishing processes",
        "construction": "Fabric weave pattern (warp x weft thread count)",
        "quality": "Grade indicating fabric standard and finish",
        "meters": "Standard length measurement in textile industry",
        "inches": "Width measurement for fabric"
      },
      "common_queries": [
        {
          "pattern": "greige total",
          "intent": "Total greige fabric quantity in meters",
          "sql_template": "SELECT SUM(METERS) as TotalMeters FROM GreigeData"
        },
        {
          "pattern": "department wise",
          "intent": "Group greige data by department",
          "sql_template": "SELECT DEPARTMENT, SUM(METERS) as TotalMeters, SUM(AMOUNT) as TotalAmount FROM GreigeData GROUP BY DEPARTMENT"
        },
        {
          "pattern": "quality wise",
          "intent": "Breakdown by quality grade",
          "sql_template": "SELECT QUALITY, COUNT(*) as Count, SUM(METERS) as TotalMeters FROM GreigeData GROUP BY QUALITY"
        }
      ],
      "sample_questions": [
        "Show greige fabric received by department this month",
        "What is the total amount spent on greige fabric?",
        "Which quality grade has the most meters?",
        "Compare greige suppliers by total meters supplied"
      ]
    }
  },
  
  "global_business_context": {
    "industry": "Pakistani Textile Manufacturing",
    "currency": "PKR (Pakistani Rupees) - ₨",
    "common_terms": {
      "greige": "Unfinished fabric before dyeing/finishing",
      "CT": "Carton - packaging unit",
      "PC": "Pieces - count unit",
      "arrival": "Incoming stock/inventory",
      "issue": "Outgoing stock/inventory usage",
      "wise": "Grouped by (e.g., 'supplier wise' means 'grouped by supplier')"
    },
    "query_patterns": {
      "vague_indicators": [
        "Single word queries",
        "Just column name (e.g., 'supplier name')",
        "'X total' without specifics",
        "'X wise' without clear grouping intent",
        "'show X' without details"
      ],
      "common_intents": {
        "list": "User wants to see all unique values",
        "total": "User wants sum or aggregation",
        "wise": "User wants data grouped by that dimension",
        "top": "User wants ranked results",
        "recent": "User wants latest/newest records"
      }
    }
  },
  
  "ai_training_guidelines": {
    "always_include_units": true,
    "default_currency": "PKR",
    "default_weight": "LBS for yarn",
    "default_length": "meters for fabric",
    "clarify_on_ambiguity": true,
    "learn_from_corrections": true,
    "context_awareness": "Understand Pakistani business terminology and informal query styles"
  }
}
